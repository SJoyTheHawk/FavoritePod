{
  "manifest_version": 3,
  "name": "FavoritePod",
  "version": "0.1.0",
  "description": "A visual launcher for favorite web pages and local tools.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open FavoritePod",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "src/dashboard/dashboard.html",
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "permissions": ["activeTab", "favicon", "unlimitedStorage", "identity", "alarms"],
  "host_permissions": ["file:///*", "https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "301335487475-rpips565ff5gqc6s8dhp3buhpkroqb7h.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.appdata"]
  },
  "optional_permissions": ["history", "topSites"]
}
